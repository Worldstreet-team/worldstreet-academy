# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Env backups
.env.local.production
.env.local.development

# Local mock-mode MongoDB data (pnpm dev:mock)
/.local-db
.gstack/

# Local project memory (Mastery Academy notes) — never commit
/memory.md

# Art renderer output (scripts/art/school-covers/render.mjs) — the shipped
# files are the WebPs under public/art/; the renderer source stays tracked
/scripts/art/schools/
/scripts/art/programs/
/scripts/art/preview/
/scripts/art/preview-programs/
/scripts/art/tmp/
/scripts/art/contact-*.png
